# watsonx.ai Configuration
# Get these from IBM Cloud watsonx.ai console
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Server Configuration
PORT=3001
NODE_ENV=development

# ==================================================
# HOW TO GET YOUR WATSONX.AI CREDENTIALS:
# ==================================================
# 1. Go to https://cloud.ibm.com/
# 2. Create a watsonx.ai instance if you don't have one
# 3. Open the watsonx.ai console
# 4. Go to Manage > Access (IAM) > API keys to create an API key
# 5. Your Project ID is in the URL when you're in a project:
#    https://dataplatform.cloud.ibm.com/wx/home?context=wx&project_id=YOUR_PROJECT_ID
# 6. The URL depends on your region:
#    - US South: https://us-south.ml.cloud.ibm.com
#    - EU Germany: https://eu-de.ml.cloud.ibm.com
#    - Tokyo: https://jp-tok.ml.cloud.ibm.com
# ==================================================
